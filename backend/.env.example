# Backend (FastAPI) and workflow service share these. Never commit a real .env.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
RENDER_API_KEY=
RENDER_WORKFLOW_SLUG=
WORKFLOW_EVENT_SECRET=change-me
WEB_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
SENTRY_DSN=

# Optional overrides (defaults in app/config.py)
LLM_EFFORT=low
LLM_THINKING_DISABLED=true
LLM_STRUCTURED_OUTPUTS=true
VARIANT_BATCHES=4
COMMENTER_BATCHES_PER_POST=2
LLM_CONCURRENCY=12
MAX_ACTIVE_RUNS=2
MAX_RUNS_PER_HOUR=60
